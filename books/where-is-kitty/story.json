  "pages": [
    {
      "image": "images/p1.webp",
      "text": "Lucy has a little white cat. The cat's name is Kitty."
    },
    {
      "image": "images/p2.webp",
      "text": "One sunny morning, Lucy looks in the box. Kitty is not there!"
    },
    {
      "image": "images/p3.webp",
      "text": "Lucy looks in the room. She looks under the bed. No Kitty."
    },
    {
      "image": "images/p4.webp",
      "text": "Lucy goes to the garden. She looks and looks. No Kitty."
    },
    {
      "image": "images/p5.webp",
      "text": "A little bird in the tree says, \"Look up! Look up!\""
    },
    {
      "image": "images/p6.webp",
      "text": "Lucy looks up. Kitty is in the big green tree!"
    },
    {
      "image": "images/p7.webp",
      "text": "\"Come down, Kitty!\" Kitty jumps down. Lucy hugs her."
    },
    {
      "image": "images/p8.webp",
      "text": "Lucy is happy. \"You are my good friend, Kitty. I love you!\""
    }
  ]
